# 复制到 backend/.env；真实凭证禁止提交。以下仅适用于本地 Compose。
SCORE_APP_NAME=Score API
DATABASE_URL=mysql+pymysql://score:local-score-only@127.0.0.1:3306/score
# 用户名和密码中的特殊字符需要 URL 编码。TLS 参数由实例证书要求配置。
# 连接预算固定为每 API 进程 5+5，每 worker 进程 2+0，迁移使用独立短连接。
SCORE_DB_POOL_TIMEOUT=3
SCORE_DB_POOL_RECYCLE=300
SCORE_DB_CONNECT_TIMEOUT=3
SCORE_DB_READ_TIMEOUT=5
SCORE_DB_WRITE_TIMEOUT=5
SCORE_DB_LOCK_WAIT_TIMEOUT=3
# Redis 本批仅提供本地容器，应用通知与降级逻辑在后续批次接入。
# 本机 HTTP 联调显式关闭 Secure；生产必须保持 true，并将来源改为 HTTPS 域名。
SCORE_COOKIE_SECURE=false
SCORE_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SCORE_SESSION_TTL_SECONDS=28800
SCORE_LOGIN_WINDOW_SECONDS=300
SCORE_LOGIN_IP_LIMIT=30
SCORE_LOGIN_ACCOUNT_LIMIT=10
# 06 凭证服务需单独配置稳定的随机 32 字节 HMAC 密钥（64 位 hex）。
# 生成：python -c 'import secrets; print(secrets.token_hex(32))'
# SCORE_CREDENTIAL_HMAC_KEY=在受保护配置中填入随机值；所有进程保持一致
# 08 独立评委会话、确认令牌与共享限流。
SCORE_JUDGE_SESSION_TTL_SECONDS=86400
SCORE_JUDGE_CONFIRMATION_TTL_SECONDS=180
SCORE_JUDGE_LIMIT_WINDOW_SECONDS=300
SCORE_JUDGE_SOURCE_LIMIT=600
SCORE_JUDGE_EVENT_LIMIT=3000
SCORE_JUDGE_ATTEMPT_LIMIT=10
