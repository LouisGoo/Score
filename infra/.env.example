# Copy to repository root as .env.production; never commit real credentials.
PUBLIC_BASE_URL=https://score.example.org
DATABASE_URL=mysql+pymysql://score:CHANGE_ME@db.example.org:3306/score?ssl_ca=/certs/mysql-ca.pem&ssl_verify_cert=true&ssl_verify_identity=true
SCORE_CREDENTIAL_HMAC_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
